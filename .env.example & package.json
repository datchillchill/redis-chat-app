# ===== FILE: .env.example =====
# Copy to .env và điều chỉnh giá trị

# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Chat Configuration
USER_PRESENCE_TTL=15
MESSAGE_HISTORY_LIMIT=100
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW=60

